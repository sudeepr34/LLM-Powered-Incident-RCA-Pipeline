# General runtime settings
RCA_LOG_LEVEL=INFO
RCA_DEFAULT_SOURCE=unknown

# Alerts that start within this many seconds of the first alert are treated as
# one incident. Anything later is flagged "separate" rather than merged.
RCA_CORRELATION_WINDOW_SECONDS=900

# LLM summarisation. Leave disabled to use the deterministic summary.
# Providers: offline | openai | ollama
RCA_ENABLE_LLM=false
RCA_LLM_PROVIDER=offline
RCA_LLM_MODEL=
# openai: defaults to https://api.openai.com/v1. Point at any OpenAI-compatible
# endpoint (vLLM, Groq, OpenRouter, LM Studio) to self-host.
# ollama: defaults to http://localhost:11434
RCA_LLM_BASE_URL=
RCA_LLM_TIMEOUT_SECONDS=20
RCA_LLM_MAX_RETRIES=2
RCA_LLM_TEMPERATURE=0.2
RCA_LLM_MAX_TOKENS=600
# Scrub IPs, emails, UUIDs, and credential-shaped strings from the prompt
# before it leaves the process. Keep this on for hosted providers.
RCA_LLM_REDACT=true

# Sensitive values. Required only for the openai provider.
RCA_LLM_API_KEY=
RCA_DB_PASSWORD=
RCA_DATABASE_URL=sqlite:///./rca.db
